# Chorus v0 — environment variables
#
# Leave these unset to run in DEMO mode (in-memory seed, no external services).
# Set them to connect the real Supabase Postgres / Auth / Storage backend.

# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Bypasses RLS; used to serve scoped
# external-reviewer (magic-link) access. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute base URL, used to build magic-link invite URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: direct Postgres connection string for running migrations via psql.
# SUPABASE_DB_URL=
