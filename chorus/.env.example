# Chorus v0 — environment variables
#
# Leave these unset to run in DEMO mode (in-memory seed, no external services).
# Set them to connect the real Supabase Postgres / Auth / Storage backend.

# Supabase project URL and publishable key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — SERVER ONLY. Bypasses RLS; used to serve scoped external-reviewer
# (magic-link) access. Never expose to the client.
SUPABASE_SECRET_KEY=

# Optional: JWKS endpoint for integrations that verify Supabase JWTs directly.
# Defaults to ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# SUPABASE_JWKS_URL=

# Legacy aliases are also accepted for older Supabase projects:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Absolute base URL, used to build magic-link invite URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Postgres connection strings for SQL/ORM tooling.
# Use the transaction-mode pooler for app/runtime clients that need IPv4.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"
#
# Use the session-mode pooler for migrations and schema changes.
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"
